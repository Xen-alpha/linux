/dts-v1/;
/plugin/;

#include <dt-bindings/gpio/gpio.h>

/ {
	compatible = "brcm,brcm2835";
	fragment@0 {
		target = <&spi0>;
		__overlay__ {
			status = "okay";
			#address-cells = <1>;
			#size-cells = <0>;
			panel@0 {
				compatible = "waveshare,st7789vw-240x240";
				reg = <0>;
				spi-max-frequency = <40000000>;
				spi-cpol;
				spi-cpha;
				reset-gpios = <&gpio 27 GPIO_ACTIVE_LOW>;
				power-supply = <&panel_3v3>;
				backlight = <&panel_backlight>;
				orientation = <0>;
				sitronix,col-offset = <0>;
				sitronix,row-offset = <80>;
				/*
				sitronix,gamma-positive = /bits/ 8 <0d ca 0e 08 09 07 2d 3b 3d 34 0a 0a 1b 28>;
				sitronix,gamma-negative = /bits/ 8 <0d ca 0f 08 08 07 2e 3c 40 34 09 0b 1b 28>;
				*/
			};
		};
	};
	fragment@1 {
		target-path = "/";
		__overlay__ {
			panel_3v3: regulator-panel {
				compatible = "regulator-fixed";
				regulator-name = "panel-3v3";
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-always-on;
			};
			panel_backlight: backlight {
				compatible = "gpio-backlight";
				gpios = <&gpio 24 GPIO_ACTIVE_HIGH>;
				default-on;
			};
		};
	};
};
