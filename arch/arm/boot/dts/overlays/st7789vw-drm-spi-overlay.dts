/dts-v1/;
/plugin/;
#include <dt-bindings/gpio/gpio.h>

/ {
	compatible="brcm,brcm2835";
	spi@7e204000 {
		status = "okay";
		
		#address-cells = <1>;
		#size-cells = <0>;
		
		lcd@0 {
			compatible = "waveshare,st7789vw";
			reg = <0>;
			spi-max-frequency = <40000000>;
			dc-gpios = <&gpio 25 GPIO_ACTIVE_HIGH>;
			reset-gpios = <&gpio 27 GPIO_ACTIVE_LOW>;
			orientation = <0>;
		};
	};
};
